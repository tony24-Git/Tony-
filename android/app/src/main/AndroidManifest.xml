<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.torchapp">

    <!-- Permission caméra nécessaire pour contrôler le flash sur de nombreuses versions d'Android -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Déclaration explicite du matériel requis : flash de l'appareil photo -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="true" />

    <!-- La caméra n'est pas strictement obligatoire si seul le flash est utilisé -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TorchApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
